# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Hugging Face write token (huggingface.co -> Settings -> Access Tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Weights & Biases (wandb.ai/authorize)
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=trustrag

# Free LLM APIs — only needed for C2-B (LLM-judge calibration), around Aug 19.
# Not required for C1 or C2-A.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# History store (MongoDB Atlas). Optional: with both of these unset the API
# reports no history store and the interface keeps checks in the browser
# instead, which is real persistence and is labelled as such on the page.
#
# Atlas -> Connect -> Drivers -> Python gives the URI. The database user needs
# readWrite on this one database and nothing else; do not use an Atlas Admin
# user here. Network Access must list the IP you are demoing from.
MONGODB_URI=
MONGODB_DB=trustrag
