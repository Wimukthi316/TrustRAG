# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Hugging Face write token (huggingface.co -> Settings -> Access Tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Weights & Biases (wandb.ai/authorize)
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=trustrag

# Free LLM APIs — only needed for C2-B (LLM-judge calibration), around Aug 19.
# Not required for C1 or C2-A.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
