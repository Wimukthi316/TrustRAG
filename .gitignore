# --- secrets ---
.env
.env.local
*.key

# --- python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- node ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
*.tsbuildinfo

# --- data (never commit; RAGTruth/RAGBench are large and licensed) ---
data/raw/
data/processed/
*.jsonl
!data/**/.gitkeep

# --- model artefacts ---
checkpoints/
*.pt
*.bin
*.safetensors
wandb/

# --- results: keep small JSON metrics, drop heavy dumps ---
results/**/*.npy
results/**/*.pkl
results/**/predictions*.json
results/**/*.log
results/**/*.log.err
results/**/best/
# One-off diagnostics and scratch written while debugging a run. Useful at the
# time, never part of the record. Anything under results/ starting with an
# underscore is working material, not an artefact.
results/_*
# The judge's per-prompt cache: one file per API answer, regenerable and only
# meaningful next to the key that produced it. The metrics JSON is the artefact.
results/llm_judge/cache/

# Report tables are regenerated from the JSON by src/c1_detector/tables.py.
# The generator is the artefact; its output would only churn.
results/**/tables.md

# --- figures are regenerated; keep only final ones under paper/ ---
results/**/*.png
results/**/*.html

# The packaged single-file app. 1.7 MB, and it churns on every build: the asset
# hashes move and the bundle carries a build date. The generator is the
# artefact -- rebuild it with `npm run build` then
# `python -m src.common.package_standalone`. paper/trustrag_standalone.html is
# hand-authored and small, so that one is tracked.
paper/trustrag_app.html

# --- editor / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- setup logs ---
_*.log

# --- personal working notes, kept outside version control ---
notes/
CLAUDE.md
results/c1/smoke/
results/**/kaggle-smoke/
results/demo_pids.txt
